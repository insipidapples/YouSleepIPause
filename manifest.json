{
  "manifest_version": 2,
  "name": "You Sleep, I Pause",
  "version": "1.1",
  "description": "Pauses YouTube, Twitch, and custom sites after a configurable idle period.",
  "homepage_url": "https://github.com/insipidapples/YouSleepIPause",
  "browser_specific_settings": {
    "gecko": {
      "id": "you-sleep-i-pause@insipidapp.local",
	  "update_url": "https://raw.githubusercontent.com/insipidapples/YouSleepIPause/main/updates.json"
    }
  },
  "permissions": [
    "idle",
    "tabs",
    "storage",
    "<all_urls>"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "128": "icon.png"
  }
}
